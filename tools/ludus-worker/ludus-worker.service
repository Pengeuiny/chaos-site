# systemd --user unit. Install with:
#   mkdir -p ~/.config/systemd/user && cp ludus-worker.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now ludus-worker
#   journalctl --user -u ludus-worker -f
# Requires `loginctl enable-linger <user>` so it runs without a login session.
[Unit]
Description=CHAOS Ludus worker (sheet interpreter + Ludus automation)
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/ludus-worker
EnvironmentFile=%h/ludus-worker/.env
ExecStart=/usr/bin/xvfb-run -a /usr/bin/node worker.mjs
Restart=always
RestartSec=30

[Install]
WantedBy=default.target
